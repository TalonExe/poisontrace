  "narrative": {
    "northStar": "Research route",
    "overview": "PoisonTrace uses white working panels, an olive navigation rail and purple markers for the current task. System sans typography supports repeated setup and saved-evidence review. Conventional controls keep configuration, execution and inspection readable.\n\nThis record describes the verified frontend. The interface uses CSS and inline graphics and requires no raster illustration. Product claims remain limited to synthetic research. Page composition and task-specific direction belong in the brief under `.impeccable/surfaces/`.",
    "keyCharacteristics": [
      "White panels and olive navigation separate work from orientation.",
      "Purple identifies actions, selection and keyboard focus.",
      "Labels and independent observations explain results before technical detail."
    ],
    "rules": [
      {
        "name": "The Current Task Rule",
        "body": "Use purple for the active destination and available task actions. A colored tag alone does not establish a successful investigation.",
        "section": "colors"
      },
      {
        "name": "The Readable Evidence Rule",
        "body": "Wrap long IDs and payloads, preserve complete identifiers, and keep technical detail readable when expanded.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Separate working regions with borders, space and tonal fills; retain visible focus independently of depth.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared CSS variables for color and preserve the documented import order.",
      "Do pair state colors with explicit text and keep independent observations separate.",
      "Do keep complete result IDs, readable wrapped payloads and visible keyboard focus.",
      "Do keep navigation visible when the rail changes to its mobile layout."
    ],
    "donts": [
      "Don't introduce decorative raster images or ornamental panel shadows into this system.",
      "Don't collapse unscored, failed or unavailable observations into a success indicator.",
      "Don't promote legacy literal colors or class-specific overrides into new shared tokens."
    ]
  }
}
